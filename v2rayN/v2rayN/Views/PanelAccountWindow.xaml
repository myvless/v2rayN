<Window
    x:Class="v2rayN.Views.PanelAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="智飞云 - 我的账户"
    Width="380"
    Height="420"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock
            Text="👤"
            FontSize="48"
            HorizontalAlignment="Center"
            Margin="0,0,0,8" />
        <TextBlock
            x:Name="txtEmail"
            Text="已登录"
            FontSize="16"
            FontWeight="Bold"
            HorizontalAlignment="Center"
            Margin="0,0,0,16" />
        <Border
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,16">
            <StackPanel>
                <TextBlock
                    Text="账户详情"
                    FontSize="14"
                    FontWeight="Bold"
                    Margin="0,0,0,8" />
                <TextBlock
                    x:Name="txtLoading"
                    Text="加载中..."
                    Foreground="Gray"
                    Visibility="Collapsed" />
                <StackPanel x:Name="panelInfo">
                    <TextBlock
                        x:Name="txtExpire"
                        Text="到期时间：--"
                        Margin="0,0,0,8" />
                    <TextBlock
                        x:Name="txtTraffic"
                        Text="流量：--"
                        Margin="0,0,0,8" />
                    <ProgressBar
                        x:Name="barTraffic"
                        Height="10"
                        Minimum="0"
                        Maximum="100"
                        Value="0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Button
            x:Name="btnLogout"
            Content="退出登录"
            Height="36"
            Click="BtnLogout_Click" />
    </StackPanel>
</Window>
